# --- Database ---
# In locale; su Railway viene fornito DATABASE_URL (postgresql://...), viene
# convertito automaticamente al driver asyncpg in app/config.py.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spese

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Modello configurabile: per la massima competenza puoi usare un modello Opus.
ANTHROPIC_MODEL=claude-sonnet-4-6
# OTTIMIZZAZIONE COSTI — modello per superficie: l'estrazione documenti resta sul
# modello principale (vision + fiscale), mentre chat e proposte dell'orchestratore
# girano su un modello più economico (Haiku, ~1/3 del costo). Sicuro: la
# riservatezza dei farmaci è imposta nel codice, non dal modello. Metti "" per
# ricadere su ANTHROPIC_MODEL, o indica un altro modello.
ANTHROPIC_MODEL_CHAT=claude-haiku-4-5
ANTHROPIC_MODEL_ORCHESTRATOR=claude-haiku-4-5
# Durata cache di prompt sul prefisso statico (strumenti + system prompt). "1h"
# mantiene caldo il prefisso tra upload/chat distanti (traffico a raffiche);
# "5m" = cache standard. Conviene già da ~3 riutilizzi nell'ora.
ANTHROPIC_CACHE_TTL=1h
# Budget generoso per scontrini multipagina e verifiche fiscali.
AGENT_MAX_TOKENS=8192
AGENT_MAX_TOOL_ITERATIONS=24
# Ricerca web dell'agente per affinare/verificare le regole fiscali aggiornate.
# WEB_SEARCH_MAX_USES limita le ricerche per elaborazione (ognuna ha un costo):
# tienilo basso per frenare i costi, alzalo se servono più verifiche.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=3
WEB_SEARCH_COUNTRY=IT
# Resilienza alle chiamate Anthropic (retry su 429/5xx/529 overloaded).
# ANTHROPIC_MAX_RETRIES è passato al client SDK; ANTHROPIC_RETRY_* governa il
# retry esterno con backoff esponenziale (vedi app/services/llm.py).
ANTHROPIC_MAX_RETRIES=4
ANTHROPIC_RETRY_ATTEMPTS=5
ANTHROPIC_RETRY_BASE_DELAY=2.0
ANTHROPIC_RETRY_MAX_DELAY=30.0

# --- Agente di orchestrazione (revisione in background) ---
# Verifica la coerenza dei dati (righe ↔ totali, classificazioni, duplicati),
# segnala righe non calcolate/gestite correttamente e propone miglioramenti
# (categorie, riclassificazioni) applicati solo previo consenso.
ENABLE_ORCHESTRATOR=true
# Esegue una revisione mirata al termine di ogni caricamento documento.
ORCHESTRATOR_RUN_AFTER_UPLOAD=true
# Abilita la fase LLM (proposte intelligenti); senza API key restano le sole
# verifiche deterministiche.
ORCHESTRATOR_USE_LLM=true
ORCHESTRATOR_MAX_TOOL_ITERATIONS=12
# Scheduler periodico interno (ore). 0 = disattivato (default). Es. 24 = giornaliero.
ORCHESTRATOR_SCHEDULE_HOURS=0

# --- Auth ---
# OBBLIGATORIO in produzione: con APP_ENV!=development l'app rifiuta di avviarsi
# se JWT_SECRET resta il valore di default (chiunque potrebbe forgiare token di
# sessione). Usa una stringa lunga e casuale, es. `openssl rand -hex 32`.
JWT_SECRET=cambia-questa-stringa
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Codice di recupero per reimpostare la password via GUI quando si è chiusi fuori
# (es. admin senza codice fiscale). Vuoto = funzione disattivata. Imposta un
# valore lungo e segreto e usalo nella schermata "Password dimenticata?".
ADMIN_RECOVERY_KEY=

# --- Upload & rate limiting ---
# Dimensione massima del file caricato (MB). Sono accettati solo PDF, immagini
# (PNG/JPEG/GIF/WebP) e fogli Excel (.xls/.xlsx); gli altri tipi sono rifiutati.
MAX_UPLOAD_MB=20
# Rate limit in-memory per processo (finestre in secondi). Frenano il brute force
# su login/recupero password e gli abusi/costi su chat e upload. In deploy
# multi-worker il conteggio non è condiviso tra i processi.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_CHAT=30
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_UPLOAD=60
RATE_LIMIT_UPLOAD_WINDOW=3600

# --- Storage documenti ---
# local = volume su filesystem (su Railway monta un Volume su STORAGE_DIR)
STORAGE_BACKEND=local
STORAGE_DIR=/data/documents

# --- Ricerca semantica (opzionale, richiede pgvector + provider embedding) ---
ENABLE_SEMANTIC_SEARCH=false
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024
VOYAGE_API_KEY=

# --- App ---
# In deploy imposta APP_ENV=production: l'app rifiuta di partire se DATABASE_URL
# punta ancora al Postgres locale di default (evita errori criptici a runtime).
APP_ENV=development
CORS_ORIGINS=*
